RADAR_HOST=127.0.0.1
RADAR_PORT=8000
RADAR_DATA_DIR=./data
RADAR_AUTO_SYNC=1
RADAR_DEMO_DATA=0
RADAR_ENV=production
RADAR_ADMIN_USER=admin
RADAR_ADMIN_PASSWORD=troque-por-uma-senha-forte
# Obrigatório em produção: gere um segredo aleatório de pelo menos 32 caracteres.
RADAR_SESSION_SECRET=
# 1 para HTTPS/túnel; no desenvolvimento HTTP isolado use 0.
RADAR_SECURE_COOKIES=1
# Contas individuais ficam no SQLite com hash salgado de senha.
RADAR_ALLOW_REGISTRATION=0
# Recomendado antes de publicar: só sua equipe poderá criar conta.
RADAR_REGISTRATION_CODE=defina-um-codigo-de-convite
# Futuro endereço permanente, após escolher domínio e hospedagem.
RADAR_PUBLIC_URL=https://radar.seudominio.com.br
RADAR_SERPRO_AUTO_MONITOR=0
RADAR_SERPRO_ENV=producao
# Preencha somente após contratar a Consulta CNPJ do Serpro.
RADAR_SERPRO_CONSUMER_KEY=
RADAR_SERPRO_CONSUMER_SECRET=
RADAR_SERPRO_USER_CPF=
RADAR_SERPRO_DAILY_LIMIT=50
RADAR_SERPRO_MONITOR_DAYS=30
RADAR_SERPRO_DAILY_HOUR=6
# Opcional: URL de um feed incremental de novos CNPJs (JSON: {"cnpjs":[...]})
RADAR_DISCOVERY_URL=
RADAR_DISCOVERY_TOKEN=
