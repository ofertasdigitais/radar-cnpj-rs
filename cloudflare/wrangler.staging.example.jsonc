{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radar-cnpj-staging",
  "account_id": "SUBSTITUIR_PELO_ID_DA_CONTA_DESTINO",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory":"../static","binding":"ASSETS","run_worker_first":true},
  "d1_databases":[{"binding":"DB","database_name":"radar-cnpj-staging","database_id":"SUBSTITUIR_PELO_D1_NOVO","migrations_dir":"migrations"}],
  "vars":{"RADAR_ALLOW_REGISTRATION":"0","RADAR_ENV":"production"},
  "limits":{"cpu_ms":50}
}
